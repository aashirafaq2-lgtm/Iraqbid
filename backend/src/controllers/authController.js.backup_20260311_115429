/**
 * Normalize Iraq phone number
 * Supports: +964, 964, 00964, or leading 0 (e.g., 07701234567)
 */
function normalizeIraqPhone(phone) {
  if (!phone) return null;

  // Remove spaces and special characters except +
  let cleaned = phone.replace(/[\s-]/g, '');

  // If already starts with +, don't prefix with +964 automatically 
  // unless it's a specific Iraqi fix
  if (cleaned.startsWith('+')) {
    if (cleaned.startsWith('+964964')) {
      return '+964' + cleaned.substring(7);
    }
    return cleaned;
  }

  // If starts with 00964, replace with +964
  if (cleaned.startsWith('00964')) {
    return '+964' + cleaned.substring(5);
  }
  // If starts with 964, add +
  if (cleaned.startsWith('964')) {
    return '+' + cleaned;
  }
  // If starts with 0, replace with +964
  if (cleaned.startsWith('0')) {
    return '+964' + cleaned.substring(1);
  }
  // If it's a 10-digit number starting with 7 (e.g., 7701234567), add +964
  if (cleaned.length === 10 && cleaned.startsWith('7')) {
    return '+964' + cleaned;
  }

  // Otherwise, if it has 9-11 digits and doesn't start with +, assume it needs +964
  if (cleaned.length >= 9 && cleaned.length <= 11) {
    return '+964' + cleaned;
  }

  return cleaned;
}

/**
 * Validate Iraq phone number
 * Must start with +964, 964, 00964, or 0
 * Format: +964 followed by 9-10 digits
 */
function isValidIraqPhone(phone) {
  const normalized = normalizeIraqPhone(phone);
  if (!normalized) return false;

  // Iraq phone format: +964 followed by 9-10 digits
  const phoneRegex = /^\+964[0-9]{9,10}$/;
  return phoneRegex.test(normalized);
}

